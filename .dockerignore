# ============================================================================
# Docker Ignore File
# ============================================================================
# Specifies files and directories that should NOT be copied to Docker image.
# This reduces image size and improves security.
# ============================================================================

# Python cache and compiled files
__pycache__/
*.py[cod]
*$py.class
*.so
.Python

# Distribution / packaging
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Virtual environments
venv/
env/
ENV/
.venv
.env.local

# Environment variables (security - never include in image)
.env
.env.local
.env.*.local

# IDE and editor files
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store

# Git
.git/
.gitignore
.gitattributes

# Documentation
README.md
docs/
*.md

# Test files
tests/
test_*.py
*_test.py
.pytest_cache/
.coverage
htmlcov/
.tox/

# CI/CD
.github/
.gitlab-ci.yml
.travis.yml

# Logs
*.log
logs/

# Database files
*.db
*.sqlite
*.sqlite3

# Jupyter Notebooks
.ipynb_checkpoints
*.ipynb

# Docker files (don't include docker files in docker image)
Dockerfile
docker-compose.yml
.dockerignore

# OS files
Thumbs.db
.DS_Store

# Temporary files
tmp/
temp/
*.tmp

# Setup and config files (not needed in container)
setup.sh
setup.py
